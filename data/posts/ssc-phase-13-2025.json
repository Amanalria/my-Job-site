 background-color: #fff091; height: 80px;\">\n<h5><a href=\"https://ssc.gov.in/login\" rel=\"noopener\" target=\"_blank\"><span style=\"color: #0000ff;\"><b>Click Here</b></span></a></h5>\n</td>\n</tr>\n<tr style=\"height: 80px;\">\n<td style=\"width: 50%; text-align: center; background-color: #fff091; height: 80px;\">\n<h5><strong>Download Exam City Details</strong></h5>\n</td>\n<td style=\"width: 50.114%; text-align: center; background-color: #fff091; height: 80px;\">\n<h5><a href=\"https://ssc.gov.in/login\" rel=\"noopener\" target=\"_blank\"><span style=\"color: #0000ff;\"><b>Click Here</b></span></a></h5>\n</td>\n</tr>\n<tr style=\"height: 110px;\">\n<td style=\"width: 50%; text-align: center; background-color: #fff091; height: 110px;\">\n<h5><strong>Check Exam City Details Notice</strong></h5>\n</td>\n<td style=\"width: 50.114%; text-align: center; background-color: #fff091; height: 110px;\">\n<h5><a href=\"https://ssc.gov.in/api/attachment/uploads/masterData/NoticeBoards/Notice_16072025.pdf\" rel=\"noopener\" target=\"_blank\"><span style=\"color: #0000ff;\"><b>Click Here</b></span></a></h5>\n</td>\n</tr>\n<tr style=\"height: 80px;\">\n<td style=\"width: 50%; text-align: center; background-color: #fff091; height: 80px;\">\n<h5><strong>Check Exam Date Notice</strong></h5>\n</td>\n<td style=\"width: 50.114%; text-align: center; background-color: #fff091; height: 80px;\">\n<h5><a href=\"http://sarkariresult.com.cm/wp-content/uploads/2025/07/Phase-XIII-Exam-Schedule.pdf\" rel=\"noopener\" target=\"_blank\"><span style=\"color: #0000ff;\"><b>Click Here</b></span></a></h5>\n</td>\n</tr>\n<tr style=\"height: 80px;\">\n<td style=\"width: 50%; text-align: center; background-color: #fff091; height: 80px;\">\n<h5><strong>Apply Online Link</strong></h5>\n</td>\n<td style=\"width: 50.114%; text-align: center; background-color: #fff091; height: 80px;\">\n<h5><span style=\"color: #0000ff;\"><b><a href=\"https://ssc.gov.in/candidate-portal/one-time-registration/home-page\" r