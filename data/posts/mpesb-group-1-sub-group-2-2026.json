ponsive=\"true\" style=\"display:block\"></ins>\n<script type=\"bb81fc2a60f0145eba04117b-text/javascript\">\n     (adsbygoogle = window.adsbygoogle || []).push({});\n</script>\n<div class=\"gb-container gb-container-ec1f6e4c\">\n<h6 class=\"gb-headline gb-headline-c7683bda gb-headline-text\">MPESB Group 1 Sub Group 2 Recruitment 2026 : Vacancy Details </h6>\n<div class=\"gb-headline gb-headline-60ccea19 gb-headline-text\"><table style=\"border-collapse: collapse; width: 100%;\">\n<tbody>\n<tr>\n<td style=\"width: 24.5724%; text-align: center;\"><span style=\"font-size: 14pt;\"><strong>Post Name</strong></span></td>\n<td style=\"width: 75.4276%; text-align: center;\"><span style=\"font-size: 14pt;\"><strong>Eligibility Criteria</strong></span></td>\n</tr>\n<tr>\n<td style=\"width: 24.5724%; text-align: center;\"><span style=\"font-size: 14pt;\">Medical Social Worker</span></td>\n<td style=\"width: 75.4276%;\">\n<ul>\n<li><span style=\"font-size: 14pt;\">Candidates must possess a <strong data-end=\"120\" data-start=\"54\">Bachelor\u2019s degree in Sociology, Medical Social Work, or M.S.W.</strong> from a recognized university.</span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td style=\"width: 24.5724%; text-align: center;\"><span style=\"font-size: 14pt;\">Assistant Statistical Officer</span></td>\n<td style=\"width: 75.4276%;\">\n<ul>\n<li><span style=\"font-size: 14pt;\">Candidates must hold a <strong>second-class graduate degree</strong> in <strong>Statistics, Mathematics, or Economics</strong> from a recognized university.</span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td style=\"width: 24.5724%; text-align: center;\"><span style=\"font-size: 14pt;\">Psychological Social Worker</span></td>\n<td style=\"width: 75.4276%;\">\n<ul>\n<li><span style=\"font-size: 14pt;\">Candidates must possess a <strong data-end=\"100\" data-start=\"54\">second-class graduate degree in Psychology</strong> from a recognized university.</span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td style=\"width: 24.5724%; text-align: center;\"><span style=\"font-size: 14pt;\">Physiotherapist</span></td>\n<td style=\"width: 75.4276%;\">\n<ul>\n<li><span style=\"font-size: 14pt;\">Candidates must have a <strong data-end=\"89\" data-start=\"51\">Bachelor\u2019s degree in Physiotherapy</strong> and be <strong data-end=\"155\" data-start=\"97\">registered with the Madhya Pradesh Paramedical Council</strong>.</span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td style=\"width: 24.5724%; text-align: center;\"><span style=\"font-size: 14pt;\">Clinical Psychologist</span></td>\n<td style=\"width: 75.4276%;\">\n<ul>\n<li><span style=\"font-size: 14pt;\">Candidates must possess a <strong data-end=\"87\" data-start=\"54\">Master\u2019s degree in Psychology</strong> along with <strong data-end=\"134\" data-start=\"99\">one year of hospital experience</strong>.</span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td style=\"width: 24.5724%; text-align: center;\"><span style=\"font-size: 14pt;\">Assistant Hospital Administrator</span></td>\n<td style=\"width: 75.4276%;\">\n<ul>\n<li><span style=\"font-size: 14pt;\">Candidates must have a <strong data-end=\"120\" data-start=\"51\">Master\u2019s degree in Hospital Administration or Hospital Management</strong> along with <strong data-end=\"167\" data-start=\"132\">one year of relevant experience</strong>.</span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td style=\"width: 24.5724%; text-align: center;\"><span style=\"font-size: 14pt;\">Biochemist</span></td>\n<td style=\"width: 75.4276%;\">\n<ul>\n<li><span style=\"font-size: 14pt;\">Candidates must possess <strong data-end=\"79\" data-start=\"52\">M.M.L.T. (Biochemistry)</strong> or <strong data-end=\"103\" data-start=\"83\">MLT/Biochemistry</strong> along with <strong data-end=\"165\" data-start=\"115\">D.M.L.T. or a Diploma in Clinical Biochemistry</strong>, and must be <strong data-end=\"218\" data-start=\"179\">registered with the Medical Council</strong>.</span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td style=\"width: 24.5724%; text-align: center;\"><span style=\"font-size: 14pt;\">Hospital Assistant/Manager</span></td>\n<td style=\"width: 75.4276%;\">\n<ul>\n<li><span style=\"font-size: 14pt;\">Candidates must possess <strong data-end=\"64\" data-start=\"52\">M.M.L.T.</strong> or <strong data-end=\"88\" data-start=\"68\">MLT/Biochemistry</strong> along with <strong data-end=\"150\" data-start=\"100\">D.M.L.T. or a Diploma in Clinical Biochemistry</strong>.</span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td style=\"width: 24.5724%; text-align: center;\"><span style=\"font-size: 14pt;\">Sub-Registrar</span></td>\n<td style=\"width: 75.4276%;\">\n<ul>\n<li><span style=\"font-size: 14pt;\">Candidates must have a <strong data-end=\"120\" data-start=\"51\">Master\u2019s degree in Hospital Administration or Hospital Management</strong> along with <strong data-end=\"182\" data-start=\"132\">one year of hospital administration experience</strong>.</span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td style=\"width: 24.5724%; text-align: center;\"><span style=\"font-size: 14pt;\">Hospital Assistant/Manager</span></td>\n<td style=\"width: 75.4276%;\">\n<ul>\n<li><span style=\"font-size: 14pt;\">Candidates must possess a <strong data-end=\"134\" data-start=\"54\">Master\u2019s degree in Hospital Administration, Hospital Management, or MBA (HR)</strong> along with <strong data-end=\"220\" data-start=\"146\">three years of academic or managerial experience in a hospital setting</strong>.</span></li>\n</ul>\n</td>\n</tr>\n</tbody>\n</table>\n<p>\u00a0</p>\n<table style=\"border-collapse: collapse; width: 100%;\">\n<tbody>\n<tr>\n<td style=\"width: 100%;\">\n<ul>\n<li><span style=\"font-size: 14pt;\"><strong><span style=\"color: #800000;\">You May Also Check : </span></strong><strong><a href=\"http://sarkariresult.com.cm/rsmssb-surveyor-and-mines-supervisor-online-form-2024/\">RSMSSB Surveyor and Mines Supervisor Recruitment 2025</a></strong></span>\n<div class=\"gb-container gb-container-659bd175\">\n<div class=\"gb-