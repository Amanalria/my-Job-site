a50b697837719a-text/javascript\">\n     (adsbygoogle = window.adsbygoogle || []).push({});\n</script>\n<div class=\"gb-container gb-container-ec1f6e4c\">\n<h6 class=\"gb-headline gb-headline-c7683bda gb-headline-text\">Uttar Pradesh TET Recruitment 2026 : Vacancy Details</h6>\n<div class=\"gb-headline gb-headline-60ccea19 gb-headline-text\"><table style=\"border-collapse: collapse; width: 100%;\">\n<tbody>\n<tr>\n<td colspan=\"2\" style=\"width: 100%; text-align: center;\"><span style=\"background-color: #000080; color: #ffffff; font-size: 14pt;\"><strong>\u00a0UPESSC Uttar Pradesh TET Examination 2026 : Eligibility Criteria\u00a0</strong></span></td>\n</tr>\n<tr>\n<td style=\"width: 28.2212%; text-align: center;\"><span style=\"font-size: 14pt;\"><strong>TET Primary Teacher (Class 1-5)</strong></span></td>\n<td style=\"width: 71.7788%;\">\n<ul>\n<li data-end=\"215\" data-start=\"121\"><span style=\"font-size: 14pt;\">Candidates must have a <strong>Bachelor\u2019s degree from an NCTE-recognized institution</strong> along with a valid teacher training qualification such as<strong> BTC, B.El.Ed, or equivalent</strong>. Final-year candidates are also eligible. In general, a <strong>minimum of 50% marks in graduation</strong> or the relevant training program is required.</span></li>\n</ul>\n</td>\n</tr>\n<tr>\n<td style=\"width: 28.2212%; text-align: center;\"><span style=\"font-size: 14pt;\"><strong>TET Upper Primary Teacher (Class 6-8)</strong></span></td>\n<td style=\"width: 71.7788%;\">\n<ul>\n<li data-end=\"276\" data-start=\"121\"><span style=\"font-size: 14pt;\">Candidates must have a <strong>Bachelor\u2019s degree</strong> with at least 50% marks (45% in some cases as per rules) from an <strong>NCTE-recognized institution</strong> along with a valid teacher training qualification such as <strong>B.Ed, BTC, B.El.Ed, or equivalent</strong>. Final-year candidates of these courses are also eligible. Additionally, candidates with s<strong>pecialized education qualifications</strong> (like Special Education) from <strong>RCI-recognized institutes are eligible</strong>. In some cases, <strong>candidates with 50% marks</strong> in intermediate and a <strong>4-year integrated teaching program</strong> can also apply.</span></li>\n</ul>\n</td>\n</tr>\n</tbody>\n</table>\n<p>\u00a0</p>\n<table style=\"border-collapse: collapse; width: 100%;\">\n<tbody>\n<tr>\n<td style=\"width: 100%;\">\n<ul>\n<li><span style=\"font-size: 14pt;\"><strong><span style=\"color: #800000;\">You May Also Check :</span></strong> <a href=\"https://sarkariresult.com.cm/central-bank-specialist-officer-recruitment-2026/\" rel=\"noopener\" target=\"_blank\"><strong>Central Bank Specialist Officer Recruitment 2026</strong></a></span></li>\n</ul>\n</td>\n</tr>\n</tbody>\n</table>\n<p>\u00a0</p>\n<table style=\"border-collapse: collapse; width: 100%;\">\n<tbody>\n<tr>\n<td style=\"width: 100%; text-align: center;\"><span style=\"background-color: #000080; color: #ffffff; font-size: 14pt;\"><strong>\u00a0How To Check &amp; Download Uttar Pradesh TET Answer Key 2026\u00a0</strong></span></td>\n</tr>\n<tr>\n<td style=\"width: 100%;\">\n<ul>\n<li data-end=\"250\" data-section-id=\"7hgmgr\" data-start=\"168\"><span style=\"font-size: 14pt;\">Open the official <strong data-end=\"240\" data-start=\"188\">UPTET / Exam Regulatory Authority, Uttar Pradesh</strong> website</span></li>\n<li data-end=\"308\" data-section-id=\"1fz6cz7\" data-start=\"251\"><span style=\"font-size: 14pt;\">Click on <strong data-end=\"301\" data-start=\"262\">\u201cUPTET 2026 Answer Key\u201d</strong> link</span></li>\n<li data-end=\"406\" data-section-id=\"1gou5cq\" data-start=\"309\"><span style=\"font-size: 14pt;\">Login using your:</span>\n<ul data-end=\"406\" data-start=\"333\">\n<li data-end=\"356\" data-section-id=\"14ghz4q\" data-start=\"333\"><span style=\"font-size: 14pt;\">Registration Number</span></li>\n<li data-end=\"387\" data-section-id=\"vcamv4\" data-start=\"359\"><span style=\"fo