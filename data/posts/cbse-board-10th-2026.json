.2rem] rounded px-px py-[0.2rem] transition-colors duration-100 ease-in-out\">For subjects involving practical\u2019s, students must secure <strong data-end=\"114\" data-start=\"56\">33% separately in both theory and practical components</strong>.</span>\u00a0</span></p>\n</li>\n</ul>\n<h4 class=\"\" data-end=\"560\" data-start=\"528\"><span style=\"font-size: 14pt;\">3. <strong data-end=\"560\" data-start=\"536\">Internal Assessments</strong></span></h4>\n<ul data-end=\"723\" data-start=\"561\">\n<li class=\"\" data-end=\"602\" data-start=\"561\">\n<p class=\"\" data-end=\"602\" data-start=\"563\"><span class=\"relative -mx-px my-[-0.2rem] rounded px-px py-[0.2rem] transition-colors duration-100 ease-in-out\" style=\"font-size: 14pt;\">Students must obtain a grade higher than \u2018E\u2019 in all internal assessments.</span></p>\n</li>\n<li class=\"\" data-end=\"723\" data-start=\"603\">\n<p class=\"\" data-end=\"723\" data-start=\"605\"><span style=\"font-size: 14pt;\"><span class=\"relative -mx-px my-[-0.2rem] rounded px-px py-[0.2rem] transition-colors duration-100 ease-in-out\">Failure to do so may result in withholding of the external examination results.</span> <span class=\"ms-1 inline-flex max-w-full items-center relative top-[-0.094rem] animate-[show_150ms_ease-in]\"><span class=\"relative start-0 bottom-0 flex h-full w-full items-center\"><span class=\"flex h-4 w-full items-center justify-between overflow-hidden\"><span class=\"max-w-full grow truncate overflow-hidden text-center\">CBSE</span></span></span></span></span></p>\n</li>\n</ul>\n<h4 class=\"\" data-end=\"754\" data-start=\"725\"><span style=\"font-size: 14pt;\">4. <strong data-end=\"754\" data-start=\"733\">Compartment Exams</strong></span></h4>\n<ul data-end=\"875\" data-start=\"755\">\n<li class=\"\" data-end=\"875\" data-start=\"755\">\n<p class=\"\" data-end=\"875\" data-start=\"757\"><span class=\"relative -mx-px my-[-0.2rem] rounded px-px py-[0.2rem] transition-colors duration-100 ease-in