d\u0930\u0940 \u092f\u094b\u0917\u0940 \u0906\u0926\u093f\u0924\u094d\u092f\u0928\u093e\u0925 \u0928\u0947 \u0938\u093e\u092b \u0936\u092c\u094d\u0926\u094b\u0902 \u092e\u0947\u0902 \u0915\u0939\u093e \u0915\u093f \u0930\u093e\u091c\u094d\u092f \u0938\u0930\u0915\u093e\u0930 \u092a\u0941\u0932\u093f\u0938 \u092c\u0932 \u0915\u094b \u0914\u0930 \u092e\u091c\u092c\u0942\u0924 \u092c\u0928\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0932\u0917\u093e\u0924\u093e\u0930 \u0915\u093e\u092e \u0915\u0930 \u0930\u0939\u0940 \u0939\u0948, \u0909\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u092c\u0924\u093e\u092f\u093e \u0915\u093f \u092c\u0940\u0924\u0947 \u0935\u0930\u094d\u0937\u094b\u0902 \u092e\u0947\u0902 \u091c\u093f\u0938 \u0924\u0930\u0939 \u092a\u093e\u0930\u0926\u0930\u094d\u0936\u093f\u0924\u093e \u0914\u0930 \u0917\u0924\u093f \u0915\u0947 \u0938\u093e\u0925 \u092d\u0930\u094d\u0924\u093f\u092f\u093e\u0902 \u0939\u0941\u0908 \u0939\u0948\u0902, \u0909\u0938\u0940 \u0915\u094d\u0930\u092e \u0915\u094b \u0906\u0917\u0947 \u092c\u0922\u093c\u093e\u0924\u0947 \u0939\u0941\u090f \u0905\u092c \u092f\u0939 \u092c\u0921\u093c\u093e \u0915\u0926\u092e \u0909\u0920\u093e\u092f\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948, \u092e\u0941\u0916\u094d\u092f\u092e\u0902\u0924\u094d\u0930\u0940 \u0928\u0947 \u0905\u092a\u0928\u0947 \u0938\u0902\u092c\u094b\u0927\u0928 \u092e\u0947\u0902 \u0915\u0939\u093e \u0915\u093f \u092c\u0940\u0924\u0947 9 \u0938\u093e\u0932\u094b\u0902 \u092e\u0947\u0902 2 \u0932\u093e\u0916 20 \u0939\u091c\u093e\u0930 \u0938\u0947 \u0905\u0927\u093f\u0915 \u092a\u0941\u0932\u093f\u0938 \u0915\u0930\u094d\u092e\u093f\u092f\u094b\u0902 \u0915\u0940 \u092d\u0930\u094d\u0924\u0940 \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u092a\u0942\u0930\u0940 \u0915\u0940 \u0917\u0908 \u0939\u0948. \u092f\u0939 \u0938\u093f\u0930\u094d\u092b \u0938\u0902\u0916\u094d\u092f\u093e \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u0915\u093e\u0928\u0942\u0928-\u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093e \u0915\u094b \u092e\u091c\u092c\u0942\u0924 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0926\u093f\u0936\u093e \u092e\u0947\u0902 \u090f\u0915 \u092c\u0921\u093c\u093e \u092c\u0926\u0932\u093e\u0935 \u0939\u0948\u0964</span></li>\n</ul>\n</td>\n</tr>\n</tbody>\n</table>\n<p>\u00a0</p>\n<table style=\"border-collapse: collapse; width: 100%;\">\n<tbody>\n<tr>\n<td style=\"width: 100%; text-align: center;\"><span style=\"background-color: #000080; color: #ffffff; font-size: 14pt;\"><strong><span style=\"background-color: #000080;\">\u00a0\u092f\u0942\u092a\u0940 \u092a\u0941\u0932\u093f\u0938 \u0915\u093e\u0902\u0938\u094d\u091f\u0947\u092c\u0932 \u0915\u0940 60,244 \u092a\u0926\u094b\u0902 \u0915\u0940 \u092c\u095c\u0940 \u092d\u0930\u094d\u0924\u0940\u00a0</span></strong></span></td>\n</tr>\n<tr>\n<td style=\"width: 100%;\">\n<ul>\n<li><span style=\"font-size: 14pt; color: #000000;\">\u092e\u0941\u0916\u094d\u092f\u092e\u0902\u0924\u094d\u0930\u0940 \u092f\u094b\u0917\u0940 \u0906\u0926\u093f\u0924\u094d\u092f\u0928\u093e\u0925 \u0928\u0947 \u092c\u0924\u093e\u092f\u093e \u0915\u0940 \u0905\u092d\u0940 \u0939\u093e\u0932 \u0939\u0940 \u092e\u0947\u0902 \u0909\u0924\u094d\u0924\u0930 \u092a\u094d\u0930\u0926\u0947\u0936 \u092a\u0941\u0932\u093f\u0938 \u092d\u0930\u094d\u0924\u0940 \u090f\u0935\u0902 \u092a\u094d\u0930\u094b\u0928\u094d\u0928\u0924\u093f \u092c\u094b\u0930\u094d\u0921 \u0926\u094d\u0935\u093e\u0930\u093e 60,244 \u092a\u0926\u094b\u0902 \u092a\u0930 \u092a\u0941\u0930\u0941\u0937 \u0914\u0930 \u092e\u0939\u093f\u0932\u093e \u0915\u093e\u0902\u0938\u094d\u091f\u0947\u092c\u0932 \u092d\u0930\u094d\u0924\u0940 \u092a\u0930\u094d\u0915\u094d\u0930\u093f\u092f\u093e \u0915\u094b \u092a\u0942\u0930\u093e \u0915\u093f\u092f\u093e \u0917\u092f\u093e, \u0914\u0930 \u0907\u0928 \u0938\u092d\u0940 \u091c\u0935\u093e\u0928\u094b\u0902 \u0915\u094b \u0909\u0924\u094d\u0924\u0930 \u092a\u094d\u0930\u0926\u0947\u0936 \u0915\u0947 \u0905\u092a\u0928\u0947 \u0939\u0940 \u091f\u094d\u0930\u0947\u0928\u093f\u0902\u0917 \u0938\u0947\u0902\u091f\u0930\u094b\u0902 \u092e\u0947\u0902 \u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u0923 \u0926\u093f\u092f\u093e \u0917\u092f\u093e \u0914\u0930 \u0928\u093f\u092f\u0941\u0915\u094d\u0924\u093f \u092a\u0924\u094d\u0930 \u0935\u093f\u0924\u0930\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0930\u093e\u091c\u094d\u092f \u0915\u0947 \u0935\u093f\u092d\u093f\u0928\u094d\u0928 \u0939\u093f\u0938\u094d\u0938\u094b\u0902 \u092e\u0947\u0902 \u0909\u0928\u0915\u0940 \u092a\u094b\u0938\u094d\u091f\u093f\u0902\u0917 \u0915\u0940 \u0917\u092f\u0940</span></li>\n</ul>\n</td>\n</tr>\n</tbody>\n</table>\n<p>\u00a0</p>\n<table style=\"border-collapse: collapse; width: 100%;\">\n<tbody>\n<tr>\n<td style=\"width: 100%; text-align: center;\"><span style=\"background-color: #000080; color: #ffffff; font-size: 14pt;\"><strong><span style=\"background-color: #000080;\">\u00a0\u092f\u0942\u092a\u0940 \u092a\u0941\u0932\u093f\u0938 \u0939\u094b\u092e\u0917\u093e\u0930\u094d\u0921 \u092e\u0947\u0902 \u092d\u0940 41,000 \u092a\u0926\u094b\u0902 \u092a\u0930 \u092c\u0921\u093c\u0940 \u092d\u0930\u094d\u0924\u0940\u00a0</span></strong></span></td>\n</tr>\n<tr>\n<td style=\"width: 100%;\">\n<ul>\n<li><span style=\"font-size: 14pt; color: #000000;\">60 \u0939\u091c\u093e\u0930 \u0915\u093e\u0902\u0938\u094d\u091f\u0947\u092c\u0932 \u092d\u0930\u094d\u0924\u0940 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u092a\u0942\u0930\u094d\u0923 \u0939\u094b\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u092e\u0941\u0916\u094d\u092f\u092e\u0902\u0924\u094d\u0930\u0940 \u0928\u0947 \u092a\u0939\u0932\u0940 \u092c\u093e\u0930 \u0909\u0924\u094d\u0924\u0930 \u092a\u094d\u0930\u0926\u0947\u0936 \u092e\u0947\u0902 \u0939\u094b\u092e\u0917\u093e\u0930\u094d\u0921 \u092d\u0930\u094d\u0924\u0940 \u0915\u0947 \u0932\u093f\u090f 41,000 \u092a\u0926\u094b\u0902 \u092a\u0930 \u092d\u0930\u094d\u0924\u0940 \u0928\u093f\u0915\u093e\u0932\u0940 \u0925\u0940 \u091c\u093f\u0938\u0915\u0940 \u0906\u0935\u0947\u0926\u0928 \u092a\u0930\u094d\u0915\u094d\u0930\u093f\u092f\u093e \u092a\u0942\u0930\u094d\u0923 \u0939\u094b\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u0939\u093e\u0932 \u0939\u0940 \u092e\u0947\u0902 25, 26 \u0914\u0930 27 \u0905\u092a\u094d\u0930\u0948\u0932 \u0915\u094b \u0939\u094b\u092e\u0917\u093e\u0930\u094d\u0921 41000 \u092a\u0926\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u092a\u0930\u0940\u0915\u094d\u0937\u093e\u090f\u0902 \u0938\u0902\u092a\u0928\u094d\u0928 \u0915\u0930\u093e\u0908 \u0917\u0908 \u0939\u0948\u0902 \u0909\u0928\u094d\u0939\u094b\u0902\u0928\u0947 \u0915\u0939\u093e \u0915\u093f \u092f\u0939 \u0938\u0902\u0915\u0947\u0924 \u0939\u0948 \u0915\u093f \u0930\u093e\u091c\u094d\u092f \u0938\u0930\u0915\u093e\u0930 \u0938\u093f\u0930\u094d\u092b \u092a\u0941\u0932\u093f\u0938 \u0939\u0940 \u0928\u0939\u0940\u0902, \u092c\u0932\u094d\u0915\u093f \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0938\u0947 \u091c\u0941\u0921\u093c\u0947 \u0939\u0930 \u0935\u093f\u092d\u093e\u0917 \u0915\u094b \u092e\u091c\u092c\u0942\u0924 \u0915\u0930\u0928\u0947 \u092a\u0930 \u091c\u094b\u0930 \u0926\u0947 \u0930\u0939\u0940 \u0939\u0948\u0964</span></li>\n</ul>\n</td>\n</tr>\n</tbody>\n</table>\n<p>\u00a0</p>\n<table style=\"border-collapse: collapse; width: 100%;\">\n<tbody>\n<tr>\n<td style=\"width: 100%; text-align: center;\"><span style=\"background-color: #000080; color: #ffffff; font-size: 14pt;\"><strong><span style=\"background-color: #000080;\">\u00a0\u0905\u092c \u092f\u0942\u092a\u0940 \u092a\u0941\u0932\u093f\u0938 \u0935\u093f\u092d\u093e\u0917 \u092e\u0947\u0902 1 \u0932\u093e\u0916 \u0928\u0908 \u092d\u0930\u094d\u0924\u093f\u092f\u094b\u0902 \u0915\u0940 \u0924\u0948\u092f\u093e\u0930\u0940\u00a0</span></strong></span></td>\n</tr>\n<tr>\n<td style=\"width: 100%;\">\n<ul>\n<li><span style=\"fon