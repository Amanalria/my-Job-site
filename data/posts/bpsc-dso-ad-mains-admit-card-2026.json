687323163\" type=\"d5f6deba96746e74051b40fa-text/javascript\"></script>\n<!-- SarkariResult -->\n<ins class=\"adsbygoogle\" data-ad-client=\"ca-pub-9762662687323163\" data-ad-format=\"auto\" data-ad-slot=\"7596594071\" data-full-width-responsive=\"true\" style=\"display:block\"></ins>\n<script type=\"d5f6deba96746e74051b40fa-text/javascript\">\n     (adsbygoogle = window.adsbygoogle || []).push({});\n</script>\n<div class=\"gb-container gb-container-ec1f6e4c\">\n<h6 class=\"gb-headline gb-headline-c7683bda gb-headline-text\">BPSC DSO / Assistant Director Recruitment 2025 : Vacancy Details</h6>\n<div class=\"gb-headline gb-headline-60ccea19 gb-headline-text\"><table style=\"border-collapse: collapse; width: 100%; height: 100px;\">\n<tbody>\n<tr style=\"height: 25px;\">\n<td style=\"width: 17.2558%; text-align: center; height: 25px;\"><span style=\"font-size: 14pt;\"><strong>Post Name</strong></span></td>\n<td style=\"width: 15.6594%; text-align: center; height: 25px;\"><span style=\"font-size: 14pt;\"><strong>No. Of Post</strong></span></td>\n<td style=\"width: 67.0847%; text-align: center; height: 25px;\"><span style=\"font-size: 14pt;\"><strong>Eligibility Criteria</strong></span></td>\n</tr>\n<tr style=\"height: 25px;\">\n<td style=\"width: 17.2558%; height: 25px; text-align: center;\"><span style=\"font-size: 14pt;\">District Statistical Officer/Assistant Director</span></td>\n<td style=\"width: 15.6594%; height: 25px; text-align: center;\"><span style=\"font-size: 14pt;\">47 Post</span></td>\n<td style=\"width: 67.0847%; height: 25px;\">\n<ul>\n<li><span style=\"font-size: 14pt;\">Candidates must have a Master Degree in Statistics or Mathematics or Economics from a recognized university. This degree should be completed on or before the last date specified for submitting the application.</span></li>\n</ul>\n</td>\n</tr>\n</tbody>\n</table>\n<p>\u00a0</p>\n<table style=\"border-collapse: collapse; width: 100%;\">\n<tbody>\n<tr>\n<td style=\"width: 100%; text-align: center;\"><span style=\"background-color: #000080; color: #ffffff; font-size: 14pt;\"><strong><span style=\"color: #ffffff;\">\u00a0BPSC DSO / Assistant Director Examination 2025 : Exam Pattern</span>\u00a0</strong></span></td>\n</tr>\n<tr>\n<td style=\"width: 100%;\">\n<ul>\n<li><span style=\"font-size: 14pt;\"><strong>Exam Mode :</strong> Pre Online (CBT-Based), Mains (Written Exam), Interview\u00a0</span></li>\n<li><span style=\"font-size: 14pt;\"><strong>Question Type :</strong> (Multiple Choice Questions) Objective Type</span></li>\n<li><span style=\"font-size: 14pt;\"><strong>No. Of Marks Pre Exam :</strong> 150 Marks</span></li>\n<li><span style=\"font-size: 14pt;\"><strong>No. Of Marks Mains Exam :</strong> 1000 Marks</span></li>\n<li><span style=\"font-size: 14pt;\"><strong>No. Of Marks Interview :</strong> 120 Marks</span></li>\n<li><span style=\"font-size: 14pt;\"><strong>Subject (Syllabus) :</strong> General Awareness, English, Numerical Ability, Reasoning and Military Aptitude Test</span></li>\n<li><span style=\"font-size: 14pt;\"><strong>Pre Exam Duration :</strong> 02 Hours</span></li>\n<li><span style=\"font-size: 14pt;\"><strong>Mains Exam Duration :</strong> 03 Hours</span></li>\n<li><span style=\"font-size: 14pt;\"><strong>Marking Scheme :</strong> Correct Answer: +1 Mark, .25 Negative Marking</span></li>\n<li><span style=\"font-size: 14pt;\"><strong>Exam Language :</strong> Hindi &amp; English</span></li>\n</ul>\n</td>\n</tr>\n</tbody>\n</table>\n<p>\u00a0</p>\n<table style=\"border-collapse: collapse; width: 100%;\">\n<tbody>\n<tr>\n<td style=\"width: 100%;\">\n<ul>\n<li><span style=\"font-size: 14pt;\"><strong><span style=\"color: #800000;\">You May Also Check :</span></strong> <strong><a class=\"wp-block-latest-posts__post-title\" href=\"https://sarkariresult.com.cm/bihar-shs-ayush-medical-officer-recruitment-2025-start/\" rel=\"noopener\" target=\"_blank\">Bihar SHS Ayush Medical Officer Recruitment 2025</a></strong></span></li>\n</ul>\n</td>\n</tr>\n</tbody>\n</table>\n<p>\u00a0</p>\n<table style=\"border-collapse: collapse; width: 100%;\">\n<tbody>\n<tr>\n<td style=\"width: 100%; text-align: center;\"><span style=\"background-color: #000080; color: #ffffff; font-size: 14pt;\"><strong>\u00a0How To Check &amp; Download BPSC DSO/ AD Mains Result 2026\u00a0</strong></span></td>\n</tr>\n<tr>\n<td style=\"width: 100%;\">\n<ul>\n<li data-end=\"203\" data-start=\"165\"><span style=\"font-size: 14pt;\">Open your phone or computer browser.</span></li>\n<li data-end=\"287\" data-start=\"206\"><span style=\"font-size: 14pt;\">Type <strong data-end=\"238\" data-start=\"211\">\u201cBPSC Official Website\u201d</strong> in the search bar and go to the official site.</span></li>\n<li data-end=\"373\" data-start=\"290\"><span style=\"font-size: 14pt;\">On the homepage, find the <strong data-end=\"362\" data-start=\"316\">\u201cNotices / Advertisement / Latest Updates\u201d</strong> section.</span></li>\n<li data-end=\"447\" data-start=\"376\"><span style=\"font-size: 14pt;\">Look for the notification titled <strong data-end=\"445\" data-start=\"409\">\u201cDSO / AD Mains Result 2026.\u201d</strong></span></li>\n<li data-end=\"508\" data-start=\"450\"><span style=\"font-size: 14pt;\">Click on the notification to open the <strong data-end=\"505\" data-start=\"488\">Result PDF</strong>.</span></li>\n<li data-end=\"535\" data-start=\"511\"><span style=\"font-size: 14pt;\">Read the PDF to check:</span></li>\n<li data-end=\"682\" data-start=\"615\"><span style=\"font-size: 14pt;\">Click on <strong data-end=\"636\" data-start=\"624\">Download</strong> or <strong data-end=\"648\" data-start=\"640\">Save</strong> to keep the PDF on your device.</span></li>\n<li data-end=\"862\" data-start=\"769\"><span style=\"font-size: 14pt;\">Enter your <strong data-end=\"803\" data-start=\"780\">Registration Number</strong> and <strong data-end=\"825\" data-start=\"808\">Date of Birth</strong> to download your Mains Result.</span></li>\n<li data-end=\"939\" data-start=\"865\"><span style=\"font-size: 14pt;\">Keep checking the BPSC website regularly for new announcements or updates.</span></li>\n</ul>\n</td>\n</tr>\n</tbody>\n</table>\n<p>\u00a0</p>\n<table style=\"border-collapse: collapse; width: 100%;\">\n<tbody>\n<tr>\n<td style=\"width: 100%; text-align: center;\"><span style=\"background-color: #000080; color: #ffffff; font-size: 14pt;\"><strong><span style=\"color: #ffffff;\">\u00a0BPSC DSO / Assistant Director Recruitment 2025 : </span>Mode Of Selection\u00a0</strong></span></td>\n</tr>\n<tr>\n<td style=\"width: 100%;\">\n<ul class=\"wp-block-list\">\n<li><span style=\"font-size: 14pt;\"><b>Pre Exam</b></span></li>\n<li><span style=\"font-size: 14pt;\"><strong>Mains Exam</strong></span></li>\n</ul>\n</td>\n</tr>\n</tbody>\n</table>\n<p>\u00a0</p>\n<table style=\"border-collapse: collapse; width: 100%;\">\n<tbody>\n<tr>\n<td style=\"width: 50%; text-align: center;\"><span style=\"font-size: 14pt;\"><strong><span style=\"color: #cc0052;\">Join Our WhatsApp Channel</span></strong></span></td>\n<td style=\"width: 50%; text-align: center;\"><span style=\"font-size: 14pt;\"><strong><a href=\"https://whatsapp.com/channel/0029VaAbQf01NCrYADMLt00L\" rel=\"noopener\" target=\"_blank\">Follow Now</a></strong></span></td>\n</tr>\n<tr>\n<td style=\"width: 50%; text-align: center;\"><span style=\"font-size: 14pt;\"><strong><span style=\"color: #cc0052;\">Join Our Telegram Channel</span></strong></span></td>\n<td style=\"width: 50%; text-align: center;\"><span style=\"font-size: 14pt;\"><strong><a href=\"https://t.me/SarkariExam_info\" rel=\"noopener\" target=\"_blank\">Follow Now</a></strong></span></td>\n</tr>\n</tbody>\n</table>\n</div>\n<h6 class=\"gb-headline gb-headline-cbf2939c gb-headline-text\"><strong><strong><strong>SOME USEFUL IMPORTANT LINKS</strong></strong></strong></h6>\n<script async=\"\" crossorigin=\"anonymous\" src=\"https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=c